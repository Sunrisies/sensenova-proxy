# Encryption key for OAuth quota credentials stored in MySQL.
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret

# MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=sensenova_proxy
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_SSL=false

# Management login
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:base64url-salt:base64url-hash
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Comma-separated client keys required for /v1/* requests
PROXY_API_KEYS=client-key-1,client-key-2

# Server port
PORT=3001

# Upstream proxy request timeout in milliseconds
PROXY_REQUEST_TIMEOUT_MS=120000
