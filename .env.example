# Encryption key for OAuth quota credentials stored in SQLite.
# Generate a random value and keep it stable. Losing this key makes stored
# quota credentials unreadable.
# TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Management login
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-strong-password
# ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Comma-separated client keys required for /v1/* requests
# PROXY_API_KEYS=client-key-1,client-key-2

# Server port
PORT=3000
